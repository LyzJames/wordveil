{
  "additionalProperties": false,
  "properties": {
    "image_refs": {
      "description": "已导入图片/页/视频帧，含原件/派生坐标关系",
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Image Refs",
      "type": "array"
    },
    "question_id": {
      "description": "用户查看图片的目的",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Question Id",
      "type": "string"
    },
    "mode": {
      "description": "仅提取不自动请求生成；analyze按能力/授权执行复核",
      "enum": [
        "extract_text",
        "analyze"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "required": [
    "image_refs",
    "question_id",
    "mode"
  ],
  "title": "image_review_Input",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
