{
  "id": "image-review",
  "title": "图片文字与视觉交叉检查",
  "kind": "workflow",
  "description": "对图片/扫描页保留OCR文字兜底；生成模型支持视觉且获准时必须读取真实图片，再比较关键字段和场景观察。",
  "actors": [
    "ui",
    "agent",
    "system"
  ],
  "direct_capabilities": [
    "vault.read"
  ],
  "conditional_capabilities": [],
  "children": [
    "document-ocr",
    "media-observe",
    "evidence-read",
    "answer-compose",
    "answer-grounding"
  ],
  "handler_binding": "builtin.image.review.v1",
  "input_fields": [
    {
      "name": "image_refs",
      "type": "ImageOrPageRef[]",
      "required": true,
      "rule": "已导入图片/页/视频帧，含原件/派生坐标关系"
    },
    {
      "name": "question_id",
      "type": "ImmutableQuestionRef",
      "required": true,
      "rule": "用户查看图片的目的"
    },
    {
      "name": "mode",
      "type": "enum(extract_text,analyze)",
      "required": true,
      "rule": "仅提取不自动请求生成；analyze按能力/授权执行复核"
    }
  ],
  "version": "0.4.0-m2",
  "schema_version": "lvjin.skill/1",
  "implementation_status": "local-media",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json"
}
