{
  "additionalProperties": false,
  "properties": {
    "query_ref": {
      "description": "核心持有原始问题",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Query Ref",
      "type": "string"
    },
    "candidate_set_id": {
      "description": "与当前任务范围和快照一致",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "facet_ids": {
      "description": "只能引用已登记问题维度",
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Facet Ids",
      "type": "array"
    }
  },
  "required": [
    "query_ref",
    "candidate_set_id",
    "facet_ids"
  ],
  "title": "evidence_rerank_Input",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
