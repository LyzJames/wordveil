{
  "additionalProperties": false,
  "properties": {
    "seed_ids": {
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Seed Ids",
      "type": "array"
    },
    "relation_types": {
      "items": {
        "enum": [
          "cites",
          "amends",
          "supersedes",
          "evidence_for",
          "confirmed_fact",
          "derived_from"
        ],
        "type": "string"
      },
      "title": "Relation Types",
      "type": "array"
    },
    "max_hops": {
      "maximum": 2,
      "minimum": 0,
      "title": "Max Hops",
      "type": "integer"
    },
    "candidate_set_id": {
      "anyOf": [
        {
          "pattern": "^ref_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Set Id"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "pattern": "^ref_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    }
  },
  "required": [
    "seed_ids",
    "relation_types",
    "max_hops"
  ],
  "title": "GraphRelationsInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
