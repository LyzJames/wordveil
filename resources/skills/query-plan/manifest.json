{
  "id": "query-plan",
  "title": "查询理解与多步策略",
  "kind": "capability",
  "description": "依据原始法律金融问题和已知事实生成有限搜索策略，列出缺失事实、精确词和来源范围。",
  "actors": [
    "ui",
    "agent",
    "system"
  ],
  "direct_capabilities": [
    "vault.read",
    "generation.request"
  ],
  "children": [],
  "handler_binding": "builtin.query.plan.v1",
  "input_fields": [
    {
      "name": "question_id",
      "type": "ImmutableQuestionRef",
      "required": true,
      "rule": "原始问题由核心保存"
    },
    {
      "name": "scope_id",
      "type": "ScopeRef",
      "required": true,
      "rule": "已选资料范围"
    },
    {
      "name": "constraint_ids",
      "type": "KnownConstraintRef[]",
      "required": true,
      "rule": "不得编造地区/日期/身份"
    }
  ],
  "version": "0.1.0-m0",
  "schema_version": "lvjin.skill/1",
  "implementation_status": "contract-prototype",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json"
}
