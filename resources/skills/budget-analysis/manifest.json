{
  "id": "budget-analysis",
  "title": "账单与个人预算分析",
  "kind": "workflow",
  "description": "导入个人账单，校对账户和月份，去重分类并进行收支、现金流和预算情景分析。",
  "actors": [
    "ui",
    "agent"
  ],
  "direct_capabilities": [
    "vault.read"
  ],
  "conditional_capabilities": [],
  "children": [
    "document-import",
    "matter-manage",
    "finance-calculate",
    "lvjin-retrieval",
    "report-export",
    "image-review"
  ],
  "handler_binding": "builtin.budget.analysis.v1",
  "input_fields": [
    {
      "name": "document_versions",
      "type": "DocumentVersionRef[]",
      "required": true,
      "rule": "已选择账单版本"
    },
    {
      "name": "period",
      "type": "DateRange",
      "required": true,
      "rule": "明确月份/日期范围"
    },
    {
      "name": "account_ids",
      "type": "AccountRef[]",
      "required": true,
      "rule": "明确账户与币种范围"
    },
    {
      "name": "question_id",
      "type": "ImmutableQuestionRef",
      "required": true,
      "rule": "预算分析目标"
    }
  ],
  "version": "0.4.0-m3",
  "schema_version": "lvjin.skill/1",
  "implementation_status": "local-analysis",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json"
}
