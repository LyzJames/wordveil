{
  "$defs": {
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_versions": {
      "description": "已选择账单版本",
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Document Versions",
      "type": "array"
    },
    "period": {
      "$ref": "#/$defs/DateRange",
      "description": "明确月份/日期范围"
    },
    "account_ids": {
      "description": "明确账户与币种范围",
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Account Ids",
      "type": "array"
    },
    "question_id": {
      "description": "预算分析目标",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Question Id",
      "type": "string"
    }
  },
  "required": [
    "document_versions",
    "period",
    "account_ids",
    "question_id"
  ],
  "title": "budget_analysis_Input",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
