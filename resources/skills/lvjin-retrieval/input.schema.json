{
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "description": "保留原始问题",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Question Id",
      "type": "string"
    },
    "scope_id": {
      "description": "已授权资料/来源",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Scope Id",
      "type": "string"
    },
    "known_constraint_ids": {
      "description": "地区、事实日期和身份",
      "items": {
        "pattern": "^ref_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Known Constraint Ids",
      "type": "array"
    },
    "requested_output": {
      "description": "无生成连接时仍可证据检索",
      "enum": [
        "answer",
        "evidence_only"
      ],
      "title": "Requested Output",
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "scope_id",
    "known_constraint_ids",
    "requested_output"
  ],
  "title": "lvjin_retrieval_Input",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
