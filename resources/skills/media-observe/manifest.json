{
  "id": "media-observe",
  "title": "生成模型原生媒体读取",
  "kind": "capability",
  "description": "在端点实际支持且资料已获准时，向生成模型提供真实图片/音频/视频进行独立读取或有目标复核，记录实际覆盖。",
  "actors": [
    "ui",
    "agent",
    "system"
  ],
  "direct_capabilities": [
    "vault.read",
    "generation.request"
  ],
  "conditional_capabilities": [],
  "children": [],
  "handler_binding": "builtin.media.observe.v1",
  "input_fields": [
    {
      "name": "media_refs",
      "type": "NativeMediaRef[]",
      "required": true,
      "rule": "核心登记的图片/音频/视频版本及允许区间"
    },
    {
      "name": "question_id",
      "type": "ImmutableQuestionRef",
      "required": true,
      "rule": "原问题/窄观察目标"
    },
    {
      "name": "observation_mode",
      "type": "enum(first_read,targeted_compare)",
      "required": true,
      "rule": "first_read禁止传OCR/ASR答案以减少锚定"
    },
    {
      "name": "comparison_ref",
      "type": "ExtractionAndObservationRef",
      "required": false,
      "rule": "targeted_compare时需有效来源/版本"
    }
  ],
  "version": "0.4.0-m2",
  "schema_version": "lvjin.skill/1",
  "implementation_status": "generation",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json"
}
