{
  "schema_version": "lvjin.catalog/1",
  "version": "0.2.0-m1",
  "skills": [
    {
      "id": "document-import",
      "title": "资料导入与解析",
      "kind": "workflow",
      "description": "导入用户选定或已获准且经核心核验的资料，保留原件和版本，提取结构、按需OCR并建立索引。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.write",
        "public_knowledge.write",
        "file.selection.read",
        "vault.read"
      ],
      "conditional_capabilities": [
        "vault.write",
        "public_knowledge.write",
        "file.selection.read",
        "vault.read"
      ],
      "children": [
        "document-ocr",
        "knowledge-index"
      ],
      "handler_binding": "builtin.document.import.v1",
      "input_fields": [
        {
          "name": "selection_id",
          "type": "ImportSourceRef",
          "required": true,
          "rule": "核心签发的UI选择凭证，或已核验下载/离线知识包的ArtifactRef；绑定来源、哈希和范围，不能传路径/URL"
        },
        {
          "name": "target_ref",
          "type": "ImportTargetRef",
          "required": true,
          "rule": "核心核验的MatterRef或PublicKnowledgeCollectionRef；按真实目标选择写权限，不能将公共更新写入私密事务"
        },
        {
          "name": "import_mode",
          "type": "enum(copy,new_version)",
          "required": true,
          "rule": "显式新增副本或新版本"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "document-ocr",
      "title": "图片与扫描件 OCR",
      "kind": "capability",
      "description": "识别当前资料中的图片或扫描页，执行整页方向、按需展平、文字检测、行方向与识别，返回可追溯文字和坐标。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "vault.write",
        "local.ocr"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.document.ocr.v1",
      "input_fields": [
        {
          "name": "document_version",
          "type": "DocumentVersionRef",
          "required": true,
          "rule": "获准材料版本"
        },
        {
          "name": "page_ids",
          "type": "PageRef[]",
          "required": true,
          "rule": "不得跨版本或越过页数预算"
        },
        {
          "name": "purpose",
          "type": "enum(read,index,correct)",
          "required": true,
          "rule": "不扩大原有材料用途"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "knowledge-index",
      "title": "资料索引与删除同步",
      "kind": "capability",
      "description": "为获准的资料版本建立中文全文与语义索引，维护更新、删除、索引一致性和可重建快照。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "index.write",
        "local.embedding"
      ],
      "conditional_capabilities": [
        "graph.write"
      ],
      "children": [],
      "handler_binding": "builtin.knowledge.index.v1",
      "input_fields": [
        {
          "name": "document_versions",
          "type": "DocumentVersionRef[]",
          "required": true,
          "rule": "只接受已登记版本"
        },
        {
          "name": "operation",
          "type": "enum(build,rebuild,remove)",
          "required": true,
          "rule": "remove 需已确认删除事件或明确用户动作"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "knowledge-search",
      "title": "本地混合检索",
      "kind": "capability",
      "description": "在当前私密空间、事务及公共知识范围内执行 BM25 与向量混合召回，融合排名并返回来源候选。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "index.read",
        "local.embedding"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.knowledge.search.v1",
      "input_fields": [
        {
          "name": "queries",
          "type": "ScopedQuery[1..4]",
          "required": true,
          "rule": "q0 原始查询不可替换，最多三条有效改写"
        },
        {
          "name": "filter_ids",
          "type": "KnownFilterRef[]",
          "required": true,
          "rule": "由核心目录提供，不接受任意 SQL"
        },
        {
          "name": "snapshot_id",
          "type": "RetrievalSnapshotRef",
          "required": true,
          "rule": "固定资料/索引 generation"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "evidence-rerank",
      "title": "候选证据重排",
      "kind": "capability",
      "description": "对有权限的查询和候选原文做联合相关性评分，保留反证和子问题覆盖，精炼为答案上下文。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "local.rerank"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.evidence.rerank.v1",
      "input_fields": [
        {
          "name": "query_ref",
          "type": "ImmutableQuestionRef",
          "required": true,
          "rule": "核心持有原始问题"
        },
        {
          "name": "candidate_set_id",
          "type": "CandidateSetRef",
          "required": true,
          "rule": "与当前任务范围和快照一致"
        },
        {
          "name": "facet_ids",
          "type": "FacetRef[]",
          "required": true,
          "rule": "只能引用已登记问题维度"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "evidence-read",
      "title": "原文读取与定位",
      "kind": "capability",
      "description": "按可信证据或文档版本 ID 读取原文、父条款、页码、段落及表格位置，检查引用是否真实可定位。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.evidence.read.v1",
      "input_fields": [
        {
          "name": "evidence_ids",
          "type": "EvidenceRef[]",
          "required": true,
          "rule": "核心证据目录中存在且获准"
        },
        {
          "name": "context_mode",
          "type": "enum(exact,parent_clause,page)",
          "required": true,
          "rule": "扩展仍在同版本与读取预算内"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "graph-relations",
      "title": "资料关系与图路径",
      "kind": "capability",
      "description": "沿已记录且有原文的法规、解释、案例、合同和凭证关系做有限图扩展，解释路径来源与适用范围。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "graph.read"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.graph.relations.v1",
      "input_fields": [
        {
          "name": "seed_ids",
          "type": "EvidenceOrNodeRef[]",
          "required": true,
          "rule": "当前检索种子"
        },
        {
          "name": "relation_types",
          "type": "AllowedRelationType[]",
          "required": true,
          "rule": "仅注册的引用/解释/支持/版本关系"
        },
        {
          "name": "max_hops",
          "type": "integer[0..2]",
          "required": true,
          "rule": "受根任务候选预算二次约束"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "query-plan",
      "title": "查询理解与多步策略",
      "kind": "capability",
      "description": "依据原始法律金融问题和已知事实生成有限搜索策略，列出缺失事实、精确词和来源范围。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "generation.request"
      ],
      "conditional_capabilities": [
        "generation.request"
      ],
      "children": [],
      "handler_binding": "builtin.query.plan.v1",
      "input_fields": [
        {
          "name": "question_id",
          "type": "ImmutableQuestionRef",
          "required": true,
          "rule": "原始问题由核心保存"
        },
        {
          "name": "scope_id",
          "type": "ScopeRef",
          "required": true,
          "rule": "已选资料范围"
        },
        {
          "name": "constraint_ids",
          "type": "KnownConstraintRef[]",
          "required": true,
          "rule": "不得编造地区/日期/身份"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m2-generation",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "answer-compose",
      "title": "依据整理与答案生成",
      "kind": "capability",
      "description": "根据已登记的证据、计算结果和用户问题生成或修订答案，明确事实、前提、冲突和引用。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "generation.request"
      ],
      "conditional_capabilities": [
        "generation.request"
      ],
      "children": [],
      "handler_binding": "builtin.answer.compose.v1",
      "input_fields": [
        {
          "name": "question_id",
          "type": "ImmutableQuestionRef",
          "required": true,
          "rule": "原始问题"
        },
        {
          "name": "evidence_bundle_id",
          "type": "EvidenceBundleRef",
          "required": true,
          "rule": "只含本次获准材料"
        },
        {
          "name": "calculation_ids",
          "type": "CalculationRef[]",
          "required": true,
          "rule": "核心计算结果，可为空数组"
        },
        {
          "name": "draft_ref",
          "type": "DraftRef|null",
          "required": false,
          "rule": "修订时使用固定草稿版本及验证报告"
        },
        {
          "name": "validation_report_ref",
          "type": "ValidationReportRef|null",
          "required": false,
          "rule": "首答为空；修订必须指向与draft_ref同版本的验证报告"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m2-generation",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "answer-grounding",
      "title": "答案证据核验",
      "kind": "capability",
      "description": "核对答案引用、版本、金额和适用前提，并以固定 mmBERT 检测器辅助标记疑似不受证据支持的答案片段。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "local.grounding"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.answer.grounding.v1",
      "input_fields": [
        {
          "name": "question_id",
          "type": "ImmutableQuestionRef",
          "required": true,
          "rule": "完整原始问题"
        },
        {
          "name": "draft_ref",
          "type": "DraftRef",
          "required": true,
          "rule": "固定草稿正文与声明范围"
        },
        {
          "name": "evidence_bundle_id",
          "type": "EvidenceBundleRef",
          "required": true,
          "rule": "实际已登记联合证据"
        },
        {
          "name": "calculation_ids",
          "type": "CalculationRef[]",
          "required": true,
          "rule": "数字对照依据"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m2-generation",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "web-research",
      "title": "授权联网研究",
      "kind": "capability",
      "description": "在用户许可的查询、目的地和预算内搜索并读取公共网页，记录来源、时间、原文快照和证据位置。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "network.search",
        "network.fetch"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.web.research.v1",
      "input_fields": [
        {
          "name": "query",
          "type": "string[1..512]",
          "required": true,
          "rule": "核对真实搜索词中的敏感字段"
        },
        {
          "name": "source_ids",
          "type": "ApprovedSourceRef[]",
          "required": true,
          "rule": "获准来源/检索连接"
        },
        {
          "name": "research_purpose",
          "type": "string",
          "required": true,
          "rule": "本次用途，不新增权限"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m2-network",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "knowledge-update",
      "title": "公共知识包导入与更新",
      "kind": "workflow",
      "description": "验证并导入用户选定或已授权获取的法律金融公共知识，保存权利、来源、版本和更新差异。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "public_knowledge.write"
      ],
      "conditional_capabilities": [
        "network.update"
      ],
      "children": [
        "document-import"
      ],
      "handler_binding": "builtin.knowledge.update.v1",
      "input_fields": [
        {
          "name": "source_selection_id",
          "type": "KnowledgeSourceRef",
          "required": true,
          "rule": "本地选择凭证或已授权来源 ID"
        },
        {
          "name": "update_mode",
          "type": "enum(preview,apply)",
          "required": true,
          "rule": "应用更新需明确用户动作或仍有效更新授权"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m2-network",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "finance-calculate",
      "title": "确定性金融计算",
      "kind": "capability",
      "description": "对已确认金额、费用、日期和现金流执行可复算的收支、借款成本、还款和预算计算。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "local.calc"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.finance.calculate.v1",
      "input_fields": [
        {
          "name": "calculation_type",
          "type": "enum(sum,cashflow,loan,annualized,budget)",
          "required": true,
          "rule": "仅注册的计算方法"
        },
        {
          "name": "confirmed_inputs",
          "type": "FinancialInputRef[]",
          "required": true,
          "rule": "数值/币种/日期/方向及凭证须可追溯"
        },
        {
          "name": "assumption_ids",
          "type": "AssumptionRef[]",
          "required": true,
          "rule": "不可缺省编造计息口径"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "matter-manage",
      "title": "事务、事实与提醒",
      "kind": "capability",
      "description": "管理私密事务的资料关联、事实、金额记录、来源关系、时间线、待办、提醒和用户确认的长期记忆。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [
        "vault.write",
        "graph.write",
        "reminder.local"
      ],
      "children": [],
      "handler_binding": "builtin.matter.manage.v1",
      "input_fields": [
        {
          "name": "matter_id",
          "type": "MatterRef",
          "required": true,
          "rule": "当前空间"
        },
        {
          "name": "operation",
          "type": "enum(read,prepare_change,commit_change)",
          "required": true,
          "rule": "commit 依赖真实确认凭证"
        },
        {
          "name": "change_ref",
          "type": "PreparedChangeRef|null",
          "required": false,
          "rule": "含来源/版本和待变更项"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "report-export",
      "title": "结果预览与导出",
      "kind": "capability",
      "description": "将当前结果、证据目录或计算表整理为 Markdown/CSV，先预览真实内容再导出到用户确认的位置。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [
        "file.export"
      ],
      "children": [],
      "handler_binding": "builtin.report.export.v1",
      "input_fields": [
        {
          "name": "result_refs",
          "type": "ResultRef[]",
          "required": true,
          "rule": "当前权限和固定结果版本"
        },
        {
          "name": "format",
          "type": "enum(markdown,csv)",
          "required": true,
          "rule": "首版格式"
        },
        {
          "name": "operation",
          "type": "enum(prepare,commit)",
          "required": true,
          "rule": "commit 需核心签发输出选择/确认凭证"
        },
        {
          "name": "prepared_export_id",
          "type": "ExportDraftRef|null",
          "required": false,
          "rule": "commit 时必填；绑定已预览草稿版本/内容哈希"
        },
        {
          "name": "selection_id",
          "type": "OutputSelectionRef|null",
          "required": false,
          "rule": "commit 时必填；核心签发目标/覆盖确认凭证"
        }
      ],
      "version": "0.2.0-m1",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "m1-local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "external-tools",
      "title": "受限外部工具连接",
      "kind": "capability",
      "description": "通过已配置且获准的 MCP 连接调用明确登记的工具，限制实际目的地、资料范围、参数和返回内容。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "connector.read"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.external.tools.v1",
      "input_fields": [
        {
          "name": "binding_id",
          "type": "ApprovedToolBindingRef",
          "required": true,
          "rule": "连接 ID + 工具名 + Schema 哈希，非任意命令/URL"
        },
        {
          "name": "arguments_ref",
          "type": "ValidatedTypedArgumentsRef",
          "required": true,
          "rule": "按该 binding 专用 JSON Schema 校验"
