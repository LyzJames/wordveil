{
  "schema_version": "lvjin.catalog/1",
  "version": "0.6.0",
  "skills": [
    {
      "id": "document-import",
      "title": "资料导入与解析",
      "kind": "workflow",
      "description": "导入用户选定或已获准且经核心核验的资料，保留原件和版本，提取结构、按需OCR并建立索引。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.write",
        "file.selection.read",
        "vault.read"
      ],
      "conditional_capabilities": [
        "vault.write",
        "file.selection.read",
        "vault.read"
      ],
      "children": [
        "document-ocr",
        "knowledge-index"
      ],
      "handler_binding": "builtin.document.import.v1",
      "input_fields": [
        {
          "name": "selection_id",
          "type": "ImportSourceRef",
          "required": true,
          "rule": "核心签发的UI选择凭证，或已核验下载/离线知识包的ArtifactRef；绑定来源、哈希和范围，不能传路径/URL"
        },
        {
          "name": "target_ref",
          "type": "ImportTargetRef",
          "required": true,
          "rule": "核心核验的MatterRef或PublicKnowledgeCollectionRef；按真实目标选择写权限，不能将公共更新写入私密事务"
        },
        {
          "name": "import_mode",
          "type": "enum(copy,new_version)",
          "required": true,
          "rule": "显式新增副本或新版本"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "document-ocr",
      "title": "图片与扫描件 OCR",
      "kind": "capability",
      "description": "识别当前资料中的图片或扫描页，执行整页方向、按需展平、文字检测、行方向与识别，返回可追溯文字和坐标。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "vault.write",
        "local.ocr"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.document.ocr.v1",
      "input_fields": [
        {
          "name": "document_version",
          "type": "DocumentVersionRef",
          "required": true,
          "rule": "获准材料版本"
        },
        {
          "name": "page_ids",
          "type": "PageRef[]",
          "required": true,
          "rule": "不得跨版本或越过页数预算"
        },
        {
          "name": "purpose",
          "type": "enum(read,index,correct)",
          "required": true,
          "rule": "不扩大原有材料用途"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "knowledge-index",
      "title": "资料索引与删除同步",
      "kind": "capability",
      "description": "为获准的资料版本建立中文全文与语义索引，维护更新、删除、索引一致性和可重建快照。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "index.write",
        "local.embedding"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.knowledge.index.v1",
      "input_fields": [
        {
          "name": "document_versions",
          "type": "DocumentVersionRef[]",
          "required": true,
          "rule": "只接受已登记版本"
        },
        {
          "name": "operation",
          "type": "enum(build,rebuild,remove)",
          "required": true,
          "rule": "remove 需已确认删除事件或明确用户动作"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "evidence-read",
      "title": "原文读取与定位",
      "kind": "capability",
      "description": "按可信证据或文档版本 ID 读取原文、父条款、页码、段落及表格位置，检查引用是否真实可定位。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.evidence.read.v1",
      "input_fields": [
        {
          "name": "evidence_ids",
          "type": "EvidenceRef[]",
          "required": true,
          "rule": "核心证据目录中存在且获准"
        },
        {
          "name": "context_mode",
          "type": "enum(exact,parent_clause,page)",
          "required": true,
          "rule": "扩展仍在同版本与读取预算内"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "matter-manage",
      "title": "事务、事实与提醒",
      "kind": "capability",
      "description": "管理私密事务的资料关联、事实、金额记录、来源关系、时间线、待办、提醒和用户确认的长期记忆。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [
        "vault.write",
        "reminder.local"
      ],
      "children": [],
      "handler_binding": "builtin.matter.manage.v1",
      "input_fields": [
        {
          "name": "matter_id",
          "type": "MatterRef",
          "required": true,
          "rule": "当前空间"
        },
        {
          "name": "operation",
          "type": "enum(read,prepare_change,commit_change)",
          "required": true,
          "rule": "commit 依赖真实确认凭证"
        },
        {
          "name": "change_ref",
          "type": "PreparedChangeRef|null",
          "required": false,
          "rule": "含来源/版本和待变更项"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "report-export",
      "title": "结果预览与导出",
      "kind": "capability",
      "description": "将当前结果、证据目录或计算表整理为 Markdown/CSV，先预览真实内容再导出到用户确认的位置。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read"
      ],
      "conditional_capabilities": [
        "file.export"
      ],
      "children": [],
      "handler_binding": "builtin.report.export.v1",
      "input_fields": [
        {
          "name": "result_refs",
          "type": "ResultRef[]",
          "required": true,
          "rule": "当前权限和固定结果版本"
        },
        {
          "name": "format",
          "type": "enum(markdown,csv)",
          "required": true,
          "rule": "首版格式"
        },
        {
          "name": "operation",
          "type": "enum(prepare,commit)",
          "required": true,
          "rule": "commit 需核心签发输出选择/确认凭证"
        },
        {
          "name": "prepared_export_id",
          "type": "ExportDraftRef|null",
          "required": false,
          "rule": "commit 时必填；绑定已预览草稿版本/内容哈希"
        },
        {
          "name": "selection_id",
          "type": "OutputSelectionRef|null",
          "required": false,
          "rule": "commit 时必填；核心签发目标/覆盖确认凭证"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "vault-maintenance",
      "title": "加密备份与恢复",
      "kind": "ui-workflow",
      "description": "通过受保护的用户界面创建、校验加密备份，并在独立新位置验证恢复；不向生成模型暴露密钥。",
      "actors": [
        "ui",
        "system"
      ],
      "direct_capabilities": [
        "vault.maintenance"
      ],
      "conditional_capabilities": [
        "file.backup"
      ],
      "children": [],
      "handler_binding": "builtin.vault.maintenance.v1",
      "input_fields": [
        {
          "name": "operation",
          "type": "enum(backup,verify,restore)",
          "required": true,
          "rule": "UI 选择或预先确认的本地备份任务"
        },
        {
          "name": "selection_id",
          "type": "MaintenanceSelectionRef",
          "required": true,
          "rule": "核心签发目标/来源选择，不含口令"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "connection-settings",
      "title": "生成接口配置与能力自检",
      "kind": "ui-workflow",
      "description": "由用户配置生成/MCP连接，保存密钥并合成自检；按模态选择OCR/ASR兜底或获准原生媒体，分析入口不因缺模态被禁用。",
      "actors": [
        "ui"
      ],
      "direct_capabilities": [
        "settings.connection"
      ],
      "conditional_capabilities": [
        "credential.write",
        "network.probe"
      ],
      "children": [],
      "handler_binding": "builtin.connection.settings.v1",
      "input_fields": [
        {
          "name": "operation",
          "type": "enum(save,probe,revoke)",
          "required": true,
          "rule": "UI 明确操作"
        },
        {
          "name": "connection_draft_id",
          "type": "ConnectionDraftRef",
          "required": true,
          "rule": "核心安全 UI 中的配置引用，不包含原始 Key"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "protected-connection",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "privacy-settings",
      "title": "私密空间与授权界面",
      "kind": "ui-workflow",
      "description": "通过可信界面创建、解锁/锁定私密空间，查看/撤销授权并修改安全设置；模型不能代替用户批准。",
      "actors": [
        "ui"
      ],
      "direct_capabilities": [
        "settings.privacy"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.privacy.settings.v1",
      "input_fields": [
        {
          "name": "operation",
          "type": "enum(create,unlock,lock,view_grants,revoke_grant,change_policy)",
          "required": true,
          "rule": "受保护 UI 的明确动作"
        },
        {
          "name": "ui_request_id",
          "type": "TrustedUiRequestRef",
          "required": true,
          "rule": "不可由生成模型自行构造"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "diagnostics",
      "title": "本地诊断与问题报告",
      "kind": "capability",
      "description": "查看应用组件、资源完整性、任务状态与脱敏错误，按用户选择生成本地诊断草稿，不自动上传。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "diagnostics.redacted"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.diagnostics.v1",
      "input_fields": [
        {
          "name": "target_ref",
          "type": "ComponentOrTaskRef",
          "required": true,
          "rule": "明确组件或当前任务"
        },
        {
          "name": "detail",
          "type": "enum(status,redacted_report)",
          "required": true,
          "rule": "不含正文、凭证或原始路径"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "media-decode",
      "title": "媒体登记、解码与时间映射",
      "kind": "capability",
      "description": "在真实文件选择范围内登记音频/视频原件，提取受限帧和音轨/音频片段，保留实际时间映射与覆盖。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "vault.write",
        "file.selection.read",
        "media.decode"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.media.decode.v1",
      "input_fields": [
        {
          "name": "source_ref",
          "type": "MediaOrSelectionRef",
          "required": true,
          "rule": "核心已登记媒体版本或用户选择凭证，不能传URL/任意路径"
        },
        {
          "name": "range_ref",
          "type": "ApprovedTimeRangeRef",
          "required": true,
          "rule": "任务获准的时间/声道范围"
        },
        {
          "name": "outputs",
          "type": "DecodeOutputKind[]",
          "required": true,
          "rule": "frames/audio/metadata的受限枚举"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    },
    {
      "id": "audio-transcribe",
      "title": "本地音频文字转写",
      "kind": "capability",
      "description": "使用固定Qwen/Qwen3-ASR-0.6B-hf对纯音频或视频音轨分段转写，保留原文、回放区间与不完整状态。",
      "actors": [
        "ui",
        "agent",
        "system"
      ],
      "direct_capabilities": [
        "vault.read",
        "vault.write",
        "local.asr"
      ],
      "conditional_capabilities": [],
      "children": [],
      "handler_binding": "builtin.audio.transcribe.v1",
      "input_fields": [
        {
          "name": "audio_segments",
          "type": "AudioSegmentRef[]",
          "required": true,
          "rule": "由核心/解码Skill登记的PCM、原始时间及版本"
        },
        {
          "name": "language_hint",
          "type": "LanguageHintRef",
          "required": false,
          "rule": "用户选择或自动识别，不能编造语言"
        },
        {
          "name": "vocabulary_ref",
          "type": "ConfirmedVocabularyRef",
          "required": false,
          "rule": "仅用户确认的领域词，不含期待答案"
        }
      ],
      "version": "0.6.0",
      "schema_version": "lvjin.skill/1",
      "implementation_status": "local",
      "input_schema": "input.schema.json",
      "output_schema": "output.schema.json"
    }
  ]
}
