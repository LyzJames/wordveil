{
  "additionalProperties": false,
  "properties": {
    "matter_id": {
      "description": "借款事务",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Matter Id",
      "type": "string"
    },
    "document_versions": {
      "anyOf": [
        {
          "items": {
            "pattern": "^ref_[0-9a-f]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "默认空；获准借条/凭证版本，与media_refs/事务已确认事实至少一项非空",
      "title": "Document Versions"
    },
    "question_id": {
      "description": "分析目标与口径",
      "pattern": "^ref_[0-9a-f]{32}$",
      "title": "Question Id",
      "type": "string"
    },
    "media_refs": {
      "anyOf": [
        {
          "items": {
            "pattern": "^ref_[0-9a-f]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "默认空；获准录音/视频版本及时间范围由核心解析，不能传任意路径",
      "title": "Media Refs"
    }
  },
  "required": [
    "matter_id",
    "question_id"
  ],
  "title": "loan_analysis_Input",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
