{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rewrites",
    "missing_facts"
  ],
  "properties": {
    "rewrites": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "query"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "missing_facts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
